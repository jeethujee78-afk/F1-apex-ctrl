# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Centralized API URL configuration for backend ECS Public IP or ALB
# Example: http://YOUR_ECS_PUBLIC_IP:3000
VITE_API_BASE_URL=

# AWS Infrastructure Configs (AWS ECS, DynamoDB, S3)
AWS_REGION="ap-south-1"
DYNAMODB_TABLE="apex-ctrl-telemetry"
S3_BUCKET="apex-ctrl-assets-jeethu"
